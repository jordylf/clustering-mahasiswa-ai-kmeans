# Koneksi PostgreSQL. Untuk `npm run db:local` gunakan nilai di bawah.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/skripsi_kmeans?schema=public"

# Akun admin awal (dibuat oleh `npm run db:seed`)
ADMIN_EMAIL="admin@skripsi.local"
ADMIN_PASSWORD="admin12345"

# Rahasia untuk menandatangani cookie sesi (min. 32 karakter acak)
AUTH_SECRET="ganti-dengan-string-acak-minimal-32-karakter"

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Opsional: isi untuk memakai Python ML service (FastAPI + scikit-learn).
# Kosongkan untuk memakai engine K-Means TypeScript bawaan.
ML_API_URL=""
